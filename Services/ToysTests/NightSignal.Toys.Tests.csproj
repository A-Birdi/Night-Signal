<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Simulation/state-level tests for the 'While We Wait' toys (Addendum 02 B03-B06, B10, C01-C09).
    Run: dotnet test Services/ToysTests   (deliberately NOT part of NightSignal.Services.slnx).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>NightSignal.Toys.Tests</AssemblyName>
    <RootNamespace>NightSignal.Toys.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ToysCore/NightSignal.Core.Toys.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../Assets/Content/Data/authored/toys/*.json" Link="content/toys/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
