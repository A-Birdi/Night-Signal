<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Isolated netstandard2.1 / C# 9 build of ONLY the 'While We Wait' toy sources (Addendum 02), with the same constraints
    as the Unity asmdef NightSignal.Core (noEngineReferences, System.* + Newtonsoft.Json only). It proves the toy code
    compiles under the Unity/SharedCore language rules without depending on other in-progress Core folders.
    The sources are LINKED from $(ToysSourceDir), never copied.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NightSignal.Core.Toys</AssemblyName>
    <RootNamespace>NightSignal.Core.Toys</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ToysSourceDir Condition="'$(ToysSourceDir)' == ''">../../../Assets/Game/Core/Toys</ToysSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ToysSourceDir)/**/*.cs" Link="Toys/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
