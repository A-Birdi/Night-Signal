<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders previews and runs the objective audio checks (peak, loudness, loop seams, CPU, determinism). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ns-audio</AssemblyName>
    <RootNamespace>NightSignal.AudioTool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AudioSynth/NightSignal.AudioSynth.csproj" />
  </ItemGroup>

</Project>
